# ── Docker / docker compose (read at container start, no rebuild needed) ──
# Base URL of N-Ops Main API (no trailing slash)
API_BASE_URL=https://api.nops.app
# Cloudflare Turnstile site key for the login widget (request a key scoped to the admin domain)
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Local dev (npm run dev) ──
# Vite reads these at dev/build time; same values as above.
VITE_API_BASE_URL=https://api.nops.app
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: extra hostnames the Vite dev server accepts (comma-separated), e.g. a tunnel/dev domain
# DEV_ALLOWED_HOSTS=dev.example.com
